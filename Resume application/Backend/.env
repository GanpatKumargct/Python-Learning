# ==========================================
# EMAIL NOTIFICATION CONFIGURATION
# ==========================================
# WHY: This is strictly used for sending outgoing emails to users.
# Specifically, sending the 6-digit OTP codes to external candidates.
# This does NOT handle incoming emails or SSO login.
# WHERE TO GET: Your email provider (SendGrid, AWS SES, Zoho Mail, Gmail, etc.)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=notification-sender@company.com
SMTP_PASSWORD=changeme
# The exact email address candidates will see the OTP coming from:
OTP_EMAIL_SENDER=noreply@company.com
EMAIL_FROM_NAME="Aerospace Recruitment"

# ==========================================
# ZOHO SSO AUTHENTICATION CONFIGURATION
# ==========================================
# WHY: We use Zoho OAuth 2.0 so internal employees (Admin, PTC) can securely log in 
#      without needing separate passwords for this ERP. It acts as our Identity Provider.
# Note: The credentials here (Client ID/Secret) are strictly for the OAuth login process.
#       They are DIFFERENT from the SMTP_USER and SMTP_PASSWORD above, because the 
#       Notification Email and the SSO Login App are two separate systems!
# WHERE TO GET: https://accounts.zoho.com/developerconsole
# HOW TO SETUP: Create a "Server-based Application" to get the ID and Secret.
# 
# ZOHO_CLIENT_ID: Identifies our application to Zoho.
# ZOHO_CLIENT_SECRET: Authenticates our application to Zoho. (KEEP THIS VERY SECRET!)
# ZOHO_REDIRECT_URI: The exact endpoint in our backend where Zoho will send the user back after login.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/auth/zoho/callback
ZOHO_PEOPLE_API_BASE=https://people.zoho.com/api/v2
ZOHO_BOOKINGS_API_BASE=https://bookings.zoho.com/api/v1

APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]
