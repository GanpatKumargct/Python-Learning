# ==========================================
# ERP Infrastructure Environment Variables
# ==========================================

# 1. Database (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://erp_user:erp_password@postgres:5432/aerospace_erp

# 2. Redis (Cache & Session)
REDIS_URL=redis://redis:6379/0

# 3. RabbitMQ (Message Broker)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# 4. Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# 5. MinIO (Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_USE_SSL=false

# 6. Zoho SSO / Email API
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_API_DOMAIN=https://accounts.zoho.com
ZOHO_EMAIL_TOKEN=your_zoho_email_token

# 7. FastAPI App Config
SECRET_KEY=super_secret_jwt_signing_key
